# Salin jadi .env lalu isi. Docker compose membaca file ini.

STORE_NAME=Toko Digital
# URL publik API (tautan di email, webhook gateway)
STORE_BASE_URL=https://api.tokokamu.com
# Origin frontend Cloudflare Pages (koma bila lebih dari satu)
STORE_CORS_ORIGINS=https://tokokamu.pages.dev

# Brevo SMTP (user = login SMTP, pass = SMTP KEY — bukan API key)
# lokal: pakai Mailpit (smtp 127.0.0.1:1025, UI http://localhost:8025) untuk uji email
STORE_SMTP_HOST=smtp-relay.brevo.com
STORE_SMTP_PORT=587
STORE_SMTP_USER=
STORE_SMTP_PASS=
STORE_SMTP_FROM=

# HMAC webhook adapter kustom (opsional — acak 32 byte)
STORE_PAYMENT_SECRET=
STORE_TRUSTED_PROXY=1
# aktifkan /dev/login (masuk sebagai akun mana pun tanpa password) — JANGAN di
# produksi; server menolak start bila digabung https / CORS origins
STORE_DEV_LOGIN=0

# admin awal `./store seed` (password kosong = digenerate acak, dicetak sekali)
#STORE_SEED_ADMIN_EMAIL=admin@tokokamu.com
#STORE_SEED_ADMIN_PASSWORD=

# gambar produk di bucket Cloudflare R2 (kosong = fallback kredensial dari
# ~/.mc/config.json alias r2; fitur mati bila keduanya tidak ada)
#STORE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#STORE_R2_ACCESS_KEY=
#STORE_R2_SECRET_KEY=
#STORE_R2_BUCKET=webapp
#STORE_R2_PREFIX=go-self-digital-store
#STORE_R2_PUBLIC_BASE=
STORE_BACKUP_KEEP=7
